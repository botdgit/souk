{
  "name": "souk",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/mobile"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@souk/api",
    "dev:mobile": "npm run start --workspace=@souk/mobile",
    "ios": "npm run ios --workspace=@souk/mobile",
    "android": "npm run android --workspace=@souk/mobile",
    "build:api": "npm run build --workspace=@souk/api",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
