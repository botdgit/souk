{
  "expo": {
    "name": "Souk",
    "slug": "souk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "souk",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0E0E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ae.souk.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Souk needs camera access to photograph items for your listings.",
        "NSPhotoLibraryUsageDescription": "Souk needs photo library access to upload listing images.",
        "NSFaceIDUsageDescription": "Souk uses Face ID for secure authentication."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0E0E"
      },
      "package": "ae.souk.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D4A853"
        }
      ],
      [
        "expo-camera",
        { "cameraPermission": "Souk needs camera access for listing photos." }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Souk needs photo access for listing images." }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
